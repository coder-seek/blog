---
/**
 * 文章目录
 *
 * 数据来自 post.render() 的 headings，锚点由 Astro 自动生成，
 * scroll-margin-top 已在 global.css 中设置。
 *
 * ≥1200px：右侧 sticky 栏，当前小节高亮
 * <1200px：折叠为正文上方的 <details>，默认收起，不挤占首屏
 */

export interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length >= 2 && (
    <aside class="toc" aria-label="文章目录">
      <details class="toc-details" open>
        <summary class="toc-summary">目录</summary>
        <nav class="toc-nav">
          <ol class="toc-list">
            {items.map((h) => (
              <li class={`toc-item toc-depth-${h.depth}`}>
                <a href={`#${h.slug}`} class="toc-link">
                  {h.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </details>
    </aside>
  )
}

<script>
  const toc = document.querySelector(".toc");
  const details = toc?.querySelector("details");

  // 折叠状态必须跟随断点，而不是只在加载时判定一次：
  // 窄屏收起（不占首屏），宽屏展开（右侧 sticky 栏依赖列表可见，否则整列空白）
  const tocMq = window.matchMedia("(max-width: 1199px)");
  const syncTocOpen = () => {
    if (details) details.open = !tocMq.matches;
  };
  syncTocOpen();
  tocMq.addEventListener("change", syncTocOpen);

  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".toc-link"));
  const nav = document.querySelector<HTMLElement>(".toc-nav");

  // ===== 目录溢出状态：只有真的可滚动时才给底边渐隐 =====
  const syncOverflowState = () => {
    if (!nav) return;
    const scrollable = nav.scrollHeight - nav.clientHeight > 2;
    const atEnd = nav.scrollTop + nav.clientHeight >= nav.scrollHeight - 2;
    nav.classList.toggle("is-scrollable", scrollable);
    nav.classList.toggle("is-at-end", atEnd);
  };

  if (nav) {
    nav.addEventListener("scroll", syncOverflowState, { passive: true });
    window.addEventListener("resize", syncOverflowState, { passive: true });
    if ("ResizeObserver" in window) {
      new ResizeObserver(syncOverflowState).observe(nav);
    }
    syncOverflowState();
  }

  // ===== 当前小节高亮 =====
  const setAriaCurrent = (index: number) => {
    links.forEach((link, i) => {
      if (i === index) link.setAttribute("aria-current", "location");
      else link.removeAttribute("aria-current");
    });
  };

  // 原生方案优先：scroll-target-group + :target-current 直接由浏览器驱动，
  // 不需要任何滚动回调。命中时高亮完全交给 CSS，这里只把状态同步给读屏
  // （:target-current 本身不暴露给辅助技术）
  const nativeScrollspy =
    CSS.supports("scroll-target-group: auto") &&
    CSS.supports("selector(:target-current)");

  if (nativeScrollspy) {
    const syncFromNative = () => {
      setAriaCurrent(links.findIndex((link) => link.matches(":target-current")));
    };
    // scrollend 触发时浏览器自己的“当前目标”可能还没落定（实测会读到上一段的
    // 结果），延后两帧再读，保证 aria 和视觉高亮指的是同一条
    const scheduleSyncFromNative = () => {
      requestAnimationFrame(() => requestAnimationFrame(syncFromNative));
    };
    let settleTimer = 0;
    syncFromNative();
    document.addEventListener("scrollend", scheduleSyncFromNative);
    // scrollend 对「瞬时」滚动不触发（实测：脚本 scrollTo、锚点跳转都不发），
    // 而 prefers-reduced-motion 下全局 scroll-behavior 就是 auto，正好落在这个盲区。
    // 所以补一个防抖兜底：只挂 passive 监听、滚动期间不做任何布局读取，
    // 停止 150ms 后才同步一次 aria，保证最终一定与视觉一致
    window.addEventListener(
      "scroll",
      () => {
        window.clearTimeout(settleTimer);
        settleTimer = window.setTimeout(scheduleSyncFromNative, 150);
      },
      { passive: true },
    );
  } else {
    // 兜底：自己算「最后一条越过阅读线的标题」，行为与改造前一致
    const targets = links
      .map((link) => {
        const id = link.getAttribute("href")?.slice(1);
        return id ? document.getElementById(id) : null;
      })
      .filter((el): el is HTMLElement => el !== null);

    if (targets.length > 0) {
      const HEADER_OFFSET = 120;
      let ticking = false;

      const setCurrent = () => {
        let current = -1;
        targets.forEach((el, i) => {
          if (el.getBoundingClientRect().top <= HEADER_OFFSET) current = i;
        });
        links.forEach((link, i) => {
          link.classList.toggle("is-current", i === current);
        });
        setAriaCurrent(current);
        ticking = false;
      };

      window.addEventListener(
        "scroll",
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(setCurrent);
          }
        },
        { passive: true },
      );

      setCurrent();
    }
  }
</script>

<style>
  .toc {
    position: sticky;
    top: calc(var(--header-h) + var(--space-2xl));
  }

  /* 桌面端不需要折叠交互，隐藏 summary 只留列表 */
  .toc-summary {
    display: none;
  }

  .toc-nav {
    max-height: calc(100vh - var(--header-h) - var(--space-5xl));
    overflow-y: auto;
    /* 原生滚动位置追踪：把这一组锚点交给浏览器判断“当前小节”，
       配合下面的 :target-current 使用。仅 Chromium 140+ 支持，其余浏览器忽略 */
    scroll-target-group: auto;
  }

  /* 列表溢出时给底边做渐隐，暗示下面还有条目。
     只在真的可滚动、且还没滚到底时生效，否则会把最后一条平白淡掉。
     用 mask 而不是半透明遮罩：背景能自然透出，也不挡选中和点击 */
  .toc-nav.is-scrollable:not(.is-at-end) {
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 calc(100% - 24px),
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      #000 calc(100% - 24px),
      transparent 100%
    );
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 1px solid var(--hairline);
  }

  .toc-item {
    margin: 0;
  }

  .toc-link {
    display: block;
    padding: 0.3rem 0 0.3rem 0.9rem;
    margin-left: -1px;
    border-left: 2px solid transparent;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--text-muted);
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .toc-link:hover {
    color: var(--text-main);
  }

  /* 原生 :target-current 与脚本兜底的 .is-current 用 :is() 合并。
     必须走 :is()：写成 ".toc-link.is-current, .toc-link:target-current" 的话，
     不认识该伪类的浏览器会把整条规则判为无效，兜底态会一起失效 */
  .toc-link:is(.is-current, :target-current) {
    color: var(--accent);
    border-left-color: var(--accent);
    /* 颜色之外补一个非色彩线索，色觉障碍用户也能看出当前项 */
    font-weight: 600;
  }

  .toc-depth-3 .toc-link {
    padding-left: 1.7rem;
    font-size: 0.78rem;
  }

  @media (max-width: 1199px) {
    .toc {
      position: static;
      /* DOM 中目录位于正文之后（桌面端靠 grid 落到右栏）。
         窄屏改为折叠摘要，只有置顶才能在阅读前当导航用，否则形同虚设 */
      order: -1;
      margin-bottom: var(--space-2xl);
    }

    .toc-summary {
      display: block;
      padding: 0.6rem 0;
      font-family: var(--font-sans);
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--text-muted);
      cursor: pointer;
      border-top: 1px solid var(--hairline);
      border-bottom: 1px solid var(--hairline);
    }

    .toc-details[open] .toc-summary {
      border-bottom-color: transparent;
    }

    .toc-details[open] .toc-nav {
      padding: var(--space-sm) 0 var(--space-md);
      border-bottom: 1px solid var(--hairline);
    }

    /* 展开动画：靠 interpolate-size（html 上已 opt-in）把 block-size 插值到 auto，
       不再需要 max-height 之类的硬编码高度。仅 Chromium 支持，其余浏览器整块忽略，
       退化为瞬时展开 */
    @supports (interpolate-size: allow-keywords) {
      .toc-details::details-content {
        block-size: 0;
        overflow: hidden;
        transition: block-size 0.32s var(--ease-out);
      }

      .toc-details[open]::details-content {
        block-size: auto;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .toc-details::details-content {
        transition: none;
      }
    }
  }
</style>
