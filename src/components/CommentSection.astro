---
/**
 * Giscus 评论组件 (https://giscus.app)
 *
 * 已配置完成，依赖三项外部设置：
 * 1. 仓库 coder-seek/blog 已启用 Discussions
 * 2. 已安装 giscus GitHub App（仅授权该仓库）
 * 3. 仓库为公开仓库 —— giscus 明确要求，私有仓库访客看不到讨论
 *
 * 下面的 data-repo-id / data-category-id 由 giscus.app 生成，是 GitHub 的内部
 * 节点 ID 而非名称。换仓库或改讨论分类后这两个值会失效，需回 giscus.app 重新生成。
 * 映射方式为 pathname：讨论按页面路径关联，不需要改域名。
 *
 * Giscus 未加载时（例如 giscus.app 不可达）自动显示兜底提示。
 */

export interface Props {
  slug: string;
  title: string;
}

const { slug, title } = Astro.props;
---

<section id="comments" class="post-comments">
  <div class="post-comments-inner card">
    <h2 class="comments-title">
      <span class="comments-title-icon">💬</span>
      评论
    </h2>
    <p class="comments-subtitle">在 GitHub Discussions 上参与讨论</p>

    <div class="giscus-wrapper">
      <div
        class="giscus"
        data-repo="coder-seek/blog"
        data-repo-id="R_kgDOTer7HA"
        data-category="Announcements"
        data-category-id="DIC_kwDOTer7HM4DHOt-"
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="top"
        data-theme="preferred_color_scheme"
        data-lang="zh-CN"
        data-loading="lazy"
        data-crossorigin="anonymous"
      ></div>
    </div>

    <div class="comments-fallback">
      <p>
        💡 评论由 Giscus（基于 GitHub Discussions）驱动，需要能访问
        <code>giscus.app</code> 与 GitHub。
      </p>
      <p>
        如果评论框一直加载不出来，多半是网络原因。你可以直接
        <a
          href="https://github.com/coder-seek/blog/discussions"
          target="_blank"
          rel="noopener">到 GitHub Discussions 参与讨论</a
        >。
      </p>
    </div>
  </div>
</section>

<script>
  (function () {
    const giscusEl = document.querySelector(".giscus");
    if (!giscusEl) return;

    // 避免重复加载
    if (giscusEl.querySelector("iframe")) return;

    const script = document.createElement("script");
    script.src = "https://giscus.app/client.js";

    // 从 data-* 属性读取配置
    for (const attr of giscusEl.attributes) {
      if (attr.name.startsWith("data-")) {
        script.setAttribute(attr.name, attr.value);
      }
    }

    script.async = true;
    script.crossOrigin = "anonymous";

    // Giscus 无 iframe 加载时显示 fallback
    const fallback = document.querySelector(".comments-fallback");
    const timeout = setTimeout(() => {
      if (!giscusEl.querySelector("iframe")) {
        if (fallback) fallback.style.display = "block";
      }
    }, 10000);

    script.onload = () => clearTimeout(timeout);
    script.onerror = () => {
      clearTimeout(timeout);
      if (fallback) fallback.style.display = "block";
    };

    giscusEl.appendChild(script);
  })();
</script>

<style>
  .post-comments {
    margin-bottom: var(--space-2xl);
    scroll-margin-top: 80px;
  }

  .post-comments-inner {
    padding: var(--space-2xl);
  }

  .comments-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    margin-bottom: var(--space-xs);
    text-align: center;
    color: var(--text-main);
    font-weight: 700;
  }

  .comments-title-icon {
    margin-right: 6px;
  }

  .comments-subtitle {
    font-size: 0.85rem;
    color: var(--text-muted);
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .giscus-wrapper {
    min-height: 120px;
  }

  /* Fallback — Giscus 未配置或加载失败时显示 */
  .comments-fallback {
    display: none;
    margin-top: var(--space-lg);
    padding: var(--space-lg);
    background: var(--accent-soft);
    border-radius: var(--radius-lg);
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .comments-fallback p {
    margin-bottom: var(--space-sm);
  }

  .comments-fallback ol {
    padding-left: 1.2rem;
  }

  .comments-fallback li {
    margin-bottom: 0.2rem;
  }

  .comments-fallback code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--code-inline-bg);
    padding: 0.1em 0.3em;
    border-radius: 3px;
  }

  @media (max-width: 768px) {
    .post-comments-inner {
      padding: var(--space-xl);
    }
  }
</style>
