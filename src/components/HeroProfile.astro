---
const socialLinks = [
  { icon: "github", href: "#", label: "GitHub" },
  { icon: "twitter", href: "#", label: "Twitter" },
  { icon: "rss", href: "/rss.xml", label: "RSS" },
];

---

<section class="hero">
  <div class="hero-frame container-wide">
    <p class="hero-eyebrow">
      <span class="eyebrow">A Personal Journal</span>
      <span class="hero-eyebrow-line" aria-hidden="true"></span>
      <span class="eyebrow">Est. 2026</span>
    </p>

    <h1 class="hero-title" aria-label="拾光记">
      <span class="hero-word"><span class="hero-char" style="--d: 0">拾</span></span>
      <span class="hero-word"><span class="hero-char" style="--d: 1">光</span></span>
      <span class="hero-word"><span class="hero-char hero-char-accent" style="--d: 2">记</span></span>
    </h1>

    <p class="hero-slogan">
      <em>The world is big, you have to go and see.</em>
    </p>

    <div class="hero-meta">
      <p class="hero-desc">
        记录技术笔记、生活随笔、读书与摄影 —— 把散落的时间，一页一页拾起来。
      </p>
      <div class="hero-actions">
        <a href="/archive" class="hero-cta">
          <span class="hero-cta-text">开始阅读</span>
          <span class="hero-cta-arrow" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </span>
        </a>
        <a href="/guestbook" class="hero-cta hero-cta-ghost">
          <span class="hero-cta-text">留言交流</span>
        </a>

        <span class="hero-socials">
          {socialLinks.map((link) => (
            <a
              href={link.href}
              class="social-link"
              aria-label={link.label}
              target="_blank"
              rel="noopener noreferrer"
            >
              {link.icon === "github" && (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
              )}
              {link.icon === "twitter" && (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              )}
              {link.icon === "rss" && (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27zm0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93z"/></svg>
              )}
            </a>
          ))}
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: min(52vh, 460px);
    padding-top: var(--header-h);
    overflow: hidden;
  }

  /* 背景一抹暖光 */
  .hero::before {
    content: "";
    position: absolute;
    top: -20%;
    right: -12%;
    width: 55vw;
    height: 55vw;
    max-width: 780px;
    max-height: 780px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      oklch(0.78 0.08 55 / 0.22),
      transparent 65%
    );
    pointer-events: none;
  }

  [data-theme="dark"] .hero::before {
    background: radial-gradient(
      circle,
      oklch(0.55 0.09 50 / 0.16),
      transparent 65%
    );
  }

  .hero-frame {
    position: relative;
    z-index: 1;
    padding-bottom: clamp(2.5rem, 6vh, 5rem);
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    margin-bottom: clamp(1.5rem, 4vh, 3rem);
    animation: fadeInUp 0.9s var(--ease-expo) 0.1s both;
  }

  .hero-eyebrow-line {
    flex: 1;
    height: 1px;
    background: var(--hairline);
  }

  /* 戏剧性大字标 — 逐字升场 */
  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 8vw, 5.5rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: 0.04em;
    margin-bottom: clamp(1rem, 3vh, 2rem);
    display: flex;
    flex-wrap: wrap;
  }

  .hero-word {
    display: inline-block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }

  .hero-char {
    display: inline-block;
    animation: riseIn 1s var(--ease-expo) both;
    animation-delay: calc(0.12s + var(--d) * 0.11s);
  }

  .hero-char-accent {
    color: var(--accent);
    font-style: italic;
  }

  .hero-slogan {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2.4vw, 1.5rem);
    font-weight: 300;
    color: var(--text-secondary);
    letter-spacing: 0.02em;
    margin-bottom: clamp(2rem, 5vh, 3.5rem);
    animation: fadeInUp 0.9s var(--ease-expo) 0.55s both;
  }

  .hero-meta {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-3xl);
    animation: fadeInUp 0.9s var(--ease-expo) 0.7s both;
  }

  .hero-desc {
    max-width: 30em;
    font-size: 0.95rem;
    color: var(--text-muted);
    margin: 0;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    flex-shrink: 0;
  }

  /* 文字式 CTA */
  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 1.5rem;
    border: 1px solid var(--text-main);
    border-radius: var(--radius-full);
    color: var(--text-main);
    font-size: 0.92rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    overflow: hidden;
    position: relative;
    transition: color 0.4s var(--ease-out), border-color 0.4s var(--ease-out);
  }

  .hero-cta::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--text-main);
    transform: translateY(101%);
    transition: transform 0.5s var(--ease-expo);
    z-index: -1;
  }

  .hero-cta:hover {
    color: var(--page-bg);
  }

  .hero-cta:hover::before {
    transform: translateY(0);
  }

  .hero-cta-arrow {
    display: flex;
    transition: transform 0.45s var(--ease-expo);
  }

  .hero-cta:hover .hero-cta-arrow {
    transform: translateX(4px);
  }

  .hero-cta-ghost {
    border-color: var(--hairline);
    color: var(--text-secondary);
  }

  .hero-cta-ghost:hover {
    border-color: var(--text-main);
  }

  .hero-socials {
    display: inline-flex;
    gap: var(--space-xs);
    margin-left: var(--space-sm);
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    color: var(--text-muted);
    transition: color var(--transition-fast), transform 0.4s var(--ease-expo);
  }

  .social-link:hover {
    color: var(--text-main);
    transform: translateY(-3px);
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
    }

    .hero-frame {
      padding-bottom: var(--space-2xl);
    }

    .hero-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2xl);
    }

    .hero-actions {
      flex-wrap: wrap;
      gap: var(--space-md);
    }

    .hero-socials {
      margin-left: 0;
    }
  }
</style>
