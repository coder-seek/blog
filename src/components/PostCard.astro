---
import { formatDateCN } from "../utils/date";
import type { CollectionEntry } from "astro:content";

export interface Props {
  post: CollectionEntry<"posts">;
  layout?: "list" | "grid";
  index?: number;
}

const { post, layout = "list", index } = Astro.props;
const { title, date, category, tags, summary, cover } = post.data;
const href = `/posts/${post.id.replace(/\.md$/, "")}`;
const indexLabel =
  typeof index === "number" ? String(index + 1).padStart(2, "0") : null;
---

<article class={`post-entry ${layout === "grid" ? "post-entry--grid" : "post-entry--list"}`}>
  {layout === "grid" && cover && (
    <a href={href} class="post-entry-cover" aria-hidden="true" tabindex="-1">
      <img src={cover} alt="" loading="lazy" decoding="async" />
    </a>
  )}
  <div class="post-entry-body">
    <div class="post-entry-side">
      {indexLabel && <span class="post-entry-index">{indexLabel}</span>}
    </div>

    <div class="post-entry-main">
      <div class="post-entry-meta">
        <a href={`/archive?category=${encodeURIComponent(category)}`} class="post-entry-category">
          {category}
        </a>
        <span class="post-entry-sep" aria-hidden="true">·</span>
        <time datetime={date.toISOString()} class="post-entry-date">
          {formatDateCN(date)}
        </time>
        {post.data.pinned && <span class="post-entry-pinned">置顶</span>}
      </div>
      <h2 class="post-entry-title">
        <a href={href}>
          <span class="post-entry-title-text">{title}</span>
          <span class="post-entry-arrow" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </span>
        </a>
      </h2>
      {summary && <p class="post-entry-summary">{summary}</p>}
      {tags.length > 0 && (
        <div class="post-entry-tags">
          {tags.map((tag) => (
            <a href={`/tags/${encodeURIComponent(tag)}`} class="tag-chip">{tag}</a>
          ))}
        </div>
      )}
    </div>
  </div>
</article>

<style>
  /* ===== 编辑部目录行 — 去卡片化 ===== */
  .post-entry--list {
    border-bottom: 1px solid var(--hairline);
    transition: background 0.4s var(--ease-out);
  }

  .post-entry--list:first-of-type {
    border-top: 1px solid var(--hairline);
  }

  .post-entry-body {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: var(--space-2xl);
    padding: var(--space-3xl) var(--space-sm);
  }

  /* 阅读列宽度上限：宽容器页（归档/标签）下标题不会被拉成长行 */
  .post-entry-main {
    max-width: var(--prose-max);
  }

  .post-entry-side {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding-top: 0.4rem;
  }

  .post-entry-index {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-style: italic;
    font-weight: 400;
    color: var(--text-muted);
    transition: color 0.4s var(--ease-out);
  }

  .post-entry--list:hover .post-entry-index {
    color: var(--accent);
  }

  .post-entry-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }

  .post-entry-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .post-entry-sep {
    color: var(--text-muted);
    opacity: 0.6;
  }

  .post-entry-category {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .post-entry-category:hover {
    color: var(--accent-hover);
  }

  .post-entry-pinned {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    color: var(--accent);
    border: 1px solid currentColor;
    border-radius: var(--radius-sm);
    padding: 0 0.5em;
  }

  .post-entry-title {
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2.6vw, 1.7rem);
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: var(--space-sm);
    letter-spacing: 0.01em;
  }

  .post-entry-title a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    color: var(--text-main);
  }

  .post-entry-title-text {
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1.5px;
    transition: background-size 0.55s var(--ease-expo);
  }

  .post-entry-title a:hover .post-entry-title-text {
    background-size: 100% 1.5px;
  }

  .post-entry-arrow {
    display: inline-flex;
    align-self: center;
    color: var(--text-muted);
    opacity: 0;
    transform: translate(-6px, 6px);
    transition: opacity 0.4s var(--ease-out), transform 0.5s var(--ease-expo),
      color 0.4s var(--ease-out);
  }

  .post-entry--list:hover .post-entry-arrow,
  .post-entry-title a:focus-visible .post-entry-arrow {
    opacity: 1;
    transform: translate(0, 0);
    color: var(--accent);
  }

  .post-entry-summary {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.75;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: var(--space-md);
    max-width: 42em;
  }

  .post-entry-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .tag-chip {
    display: inline-block;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    padding: 2px 10px;
    border: 1px solid var(--hairline);
    color: var(--text-muted);
    border-radius: var(--radius-full);
    transition: border-color var(--transition-fast),
      color var(--transition-fast);
  }

  .tag-chip::before {
    content: "#";
    opacity: 0.55;
    margin-right: 1px;
  }

  .tag-chip:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* ===== Grid 布局（带封面场景保留） ===== */
  .post-entry--grid {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-xl);
    overflow: hidden;
    transition: border-color 0.4s var(--ease-out),
      box-shadow 0.4s var(--ease-out);
  }

  .post-entry--grid:hover {
    border-color: var(--text-muted);
    box-shadow: var(--shadow-md);
  }

  .post-entry--grid .post-entry-body {
    grid-template-columns: 1fr;
    padding: var(--space-xl);
    gap: var(--space-sm);
  }

  .post-entry--grid .post-entry-side {
    flex-direction: row;
    align-items: baseline;
    padding-top: 0;
  }

  .post-entry-cover {
    display: block;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    background: var(--accent-soft);
  }

  .post-entry-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-expo), filter 0.6s var(--ease-out);
  }

  .post-entry--grid:hover .post-entry-cover img {
    transform: scale(1.05);
  }

  @media (max-width: 640px) {
    .post-entry-body {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
      padding: var(--space-2xl) var(--space-xs);
    }

    .post-entry-side {
      flex-direction: row;
      align-items: baseline;
      gap: var(--space-md);
      padding-top: 0;
    }

    .post-entry-arrow {
      display: none;
    }
  }
</style>
