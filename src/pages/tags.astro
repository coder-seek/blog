---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const tagMap: Record<string, number> = {};
posts.forEach((p) => {
  p.data.tags.forEach((t) => {
    tagMap[t] = (tagMap[t] || 0) + 1;
  });
});
const tags = Object.entries(tagMap).sort((a, b) => b[1] - a[1]);
const maxCount = tags.length > 0 ? tags[0][1] : 1;
---

<BaseLayout title="标签">
  <Header />
  <main class="page-shell">
    <div class="container-wide">
      <h1 class="page-title">标签</h1>
      <p class="page-lede">
        共 {tags.length} 个标签，字号随文章数量递增。
      </p>
      <div class="tag-cloud">
        {
          tags.map(([tag, count]) => {
            const scale = 0.85 + (count / maxCount) * 0.75;
            return (
              <a
                href={`/tags/${encodeURIComponent(tag)}`}
                class="tag-item"
                style={`font-size: ${scale.toFixed(2)}rem`}
              >
                {tag}
                <sup>{count}</sup>
              </a>
            );
          })
        }
      </div>
      {tags.length === 0 && <p class="empty-hint">暂无标签</p>}
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
    align-items: center;
  }

  .tag-item {
    color: var(--text-secondary);
    padding: 2px 4px;
    transition: color var(--transition-fast);
  }

  .tag-item:hover {
    color: var(--accent);
  }

  .tag-item sup {
    font-size: 0.65em;
    color: var(--text-muted);
    margin-left: 2px;
  }

  .empty-hint {
    text-align: center;
    color: var(--text-muted);
    padding: var(--space-3xl) 0;
  }
</style>
