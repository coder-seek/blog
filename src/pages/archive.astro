---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PostCard from "../components/PostCard.astro";
import { getCollection } from "astro:content";

const categoryFilter = Astro.url.searchParams.get("category");

const posts = await getCollection("posts", ({ data }) => {
  if (data.draft) return false;
  if (categoryFilter && data.category !== categoryFilter) return false;
  return true;
});

const sortedPosts = posts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const groups: Record<string, typeof sortedPosts> = {};
sortedPosts.forEach((post) => {
  const year = post.data.date.getFullYear().toString();
  if (!groups[year]) groups[year] = [];
  groups[year].push(post);
});
---

<BaseLayout title="归档">
  <Header />
  <main class="page-shell">
    <div class="container-wide">
      <h1 class="page-title">归档</h1>
      {
        categoryFilter ? (
          <p class="page-lede">
            筛选：{categoryFilter}
            <a href="/archive" class="clear-filter">
              清除筛选
            </a>
          </p>
        ) : (
          <p class="page-lede">
            共 {sortedPosts.length} 篇文章，按年份倒序排列。
          </p>
        )
      }

      {
        Object.keys(groups)
          .sort((a, b) => Number(b) - Number(a))
          .map((year) => (
            <section class="archive-year">
              <h2 class="year-title">
                {year}
                <span class="year-count">{groups[year].length} 篇</span>
              </h2>
              <div class="year-posts">
                {groups[year].map((post) => (
                  <PostCard post={post} layout="list" />
                ))}
              </div>
            </section>
          ))
      }

      {sortedPosts.length === 0 && <p class="empty-hint">暂无文章</p>}
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .clear-filter {
    margin-left: var(--space-sm);
    font-size: 0.85rem;
  }

  .archive-year {
    margin-bottom: var(--space-4xl);
  }

  .year-title {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    font-family: var(--font-serif);
    font-size: 1.35rem;
    padding-bottom: var(--space-sm);
    border-bottom: 2px solid var(--accent);
    margin-bottom: var(--space-lg);
  }

  .year-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .empty-hint {
    text-align: center;
    color: var(--text-muted);
    padding: var(--space-5xl) 0;
  }
</style>
