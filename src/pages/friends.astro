---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Friend {
  name: string;
  url: string;
  desc: string;
}

const friends: Friend[] = [];
---

<BaseLayout title="友链">
  <Header />
  <main class="page-content">
    <section class="page-section">
      <div class="container">
        <div class="page-card card">
          <h1 class="page-title">友链</h1>
          <p class="page-desc">有趣的灵魂终会相遇</p>
          <div class="friends-grid">
            {friends.length > 0 ? (
              friends.map((friend) => (
                <a href={friend.url} class="friend-card card" target="_blank" rel="noopener noreferrer">
                  <span class="friend-name">{friend.name}</span>
                  <span class="friend-desc">{friend.desc}</span>
                </a>
              ))
            ) : (
              <p class="empty-hint">还没有友链，欢迎交换</p>
            )}
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .page-content {
    padding-top: 72px;
  }

  .page-section {
    padding: var(--space-3xl) var(--page-x-padding) var(--space-5xl);
  }

  .page-card {
    padding: var(--space-2xl);
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: var(--space-xs);
  }

  .page-desc {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--border);
  }

  .friends-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-lg);
  }

  .friend-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-xl);
    text-decoration: none;
  }

  .friend-name {
    font-weight: 600;
    color: var(--text-main);
    margin-bottom: var(--space-xs);
  }

  .friend-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .empty-hint {
    text-align: center;
    color: var(--text-muted);
    padding: var(--space-3xl) 0;
  }
</style>
