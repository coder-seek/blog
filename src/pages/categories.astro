---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const catMap: Record<string, number> = {};
posts.forEach((p) => {
  catMap[p.data.category] = (catMap[p.data.category] || 0) + 1;
});
const categories = Object.entries(catMap).sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="分类">
  <Header />
  <main class="page-shell">
    <div class="container-wide">
      <h1 class="page-title">分类</h1>
      <p class="page-lede">
        共 {categories.length} 个分类，{posts.length} 篇文章。
      </p>
      <div class="cat-grid">
        {
          categories.map(([cat, count]) => (
            <a
              href={`/archive?category=${encodeURIComponent(cat)}`}
              class="cat-card card"
            >
              <span class="cat-card-name">{cat}</span>
              <span class="cat-card-count">{count} 篇</span>
            </a>
          ))
        }
      </div>
      {categories.length === 0 && <p class="empty-hint">暂无分类</p>}
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .cat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--space-lg);
  }

  .cat-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-xl);
    text-decoration: none;
  }

  .cat-card-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-main);
  }

  .cat-card-count {
    font-size: 0.8rem;
    color: var(--text-muted);
    background: var(--btn-bg);
    padding: 2px 12px;
    border-radius: var(--radius-full);
  }

  .empty-hint {
    text-align: center;
    color: var(--text-muted);
    padding: var(--space-5xl) 0;
  }
</style>
