---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const photos = [
  {
    src: "/assets/images/photography-placeholder-1.jpg",
    alt: "层叠山脊在晨雾中延伸",
  },
  {
    src: "/assets/images/photography-placeholder-2.jpg",
    alt: "清晨静谧的湖面倒影",
  },
];
---

<BaseLayout title="摄影">
  <Header />
  <main class="page-shell">
    <div class="container-wide">
      <h1 class="page-title">摄影</h1>
      <p class="page-lede">镜头里的世界，共 {photos.length} 张。</p>
      {
        photos.length > 0 ? (
          <div class="gallery-grid">
            {photos.map((photo) => (
              <a href={photo.src} class="gallery-item card" target="_blank" rel="noopener">
                <img
                  src={photo.src}
                  alt={photo.alt}
                  width="1600"
                  height="1200"
                  loading="lazy"
                  decoding="async"
                />
              </a>
            ))}
          </div>
        ) : (
          <p class="empty-hint">暂无照片</p>
        )
      }
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-lg);
  }

  .gallery-item {
    display: block;
    border-radius: var(--radius-xl);
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .gallery-item:hover img {
    transform: scale(1.05);
  }

  .empty-hint {
    text-align: center;
    color: var(--text-muted);
    padding: var(--space-3xl) 0;
  }

  @media (max-width: 768px) {
    .gallery-grid {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    }
  }
</style>
