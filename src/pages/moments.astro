---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MomentItem from "../components/MomentItem.astro";
import { getCollection } from "astro:content";

const moments = await getCollection("moments");
const sorted = moments.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout title="动态">
  <Header />
  <main class="page-content">
    <section class="page-section">
      <div class="container">
        <div class="page-card card">
          <h1 class="page-title">动态</h1>
          <p class="page-desc">日常碎碎念，随手记录</p>
          <div class="moments-list">
            {sorted.map((moment) => (
              <MomentItem moment={moment} />
            ))}
          </div>
          {sorted.length === 0 && (
            <p class="empty-hint">暂无动态</p>
          )}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .page-content {
    padding-top: 72px;
  }

  .page-section {
    padding: var(--space-3xl) var(--page-x-padding) var(--space-5xl);
  }

  .page-card {
    padding: var(--space-2xl);
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: var(--space-xs);
  }

  .page-desc {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--border);
  }

  .empty-hint {
    text-align: center;
    color: var(--text-muted);
    padding: var(--space-3xl) 0;
  }
</style>
