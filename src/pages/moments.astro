---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MomentItem from "../components/MomentItem.astro";
import { getCollection } from "astro:content";

const moments = await getCollection("moments");
const sorted = moments.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout title="动态">
  <Header />
  <main class="page-shell">
    <div class="container">
      <h1 class="page-title">动态</h1>
      <p class="page-lede">日常碎碎念，随手记录 —— 共 {sorted.length} 条。</p>
      <div class="moments-list">
        {sorted.map((moment) => <MomentItem moment={moment} />)}
      </div>
      {sorted.length === 0 && <p class="empty-hint">暂无动态</p>}
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .empty-hint {
    text-align: center;
    color: var(--text-muted);
    padding: var(--space-3xl) 0;
  }
</style>
