[["Map",1,2,9,10,151,152],"meta::meta",["Map",3,4,5,6,7,8],"astro-version","5.18.2","content-config-digest","90ca033eb61309f1","astro-config-digest","{\"root\":{},\"srcDir\":{},\"publicDir\":{},\"outDir\":{},\"cacheDir\":{},\"site\":\"https://example.com\",\"compressHTML\":true,\"base\":\"/\",\"trailingSlash\":\"ignore\",\"output\":\"static\",\"scopedStyleStrategy\":\"attribute\",\"build\":{\"format\":\"directory\",\"client\":{},\"server\":{},\"assets\":\"_astro\",\"serverEntry\":\"entry.mjs\",\"redirects\":true,\"inlineStylesheets\":\"auto\",\"concurrency\":1},\"server\":{\"open\":false,\"host\":true,\"port\":4321,\"streaming\":true,\"allowedHosts\":[]},\"redirects\":{},\"image\":{\"endpoint\":{\"route\":\"/_image\"},\"service\":{\"entrypoint\":\"astro/assets/services/sharp\",\"config\":{}},\"domains\":[],\"remotePatterns\":[],\"responsiveStyles\":false},\"devToolbar\":{\"enabled\":true},\"markdown\":{\"syntaxHighlight\":{\"type\":\"shiki\",\"excludeLangs\":[\"math\"]},\"shikiConfig\":{\"langs\":[],\"langAlias\":{},\"theme\":\"github-dark-dimmed\",\"themes\":{},\"wrap\":true,\"transformers\":[]},\"remarkPlugins\":[],\"rehypePlugins\":[],\"remarkRehype\":{},\"gfm\":true,\"smartypants\":true},\"security\":{\"checkOrigin\":true,\"allowedDomains\":[],\"actionBodySizeLimit\":1048576},\"env\":{\"schema\":{},\"validateSecrets\":false},\"experimental\":{\"clientPrerender\":false,\"contentIntellisense\":false,\"headingIdCompat\":false,\"preserveScriptOrder\":false,\"liveContentCollections\":false,\"csp\":false,\"staticImportMetaEnv\":false,\"chromeDevtoolsWorkspace\":false,\"failOnPrerenderConflict\":false,\"svgo\":false},\"legacy\":{\"collections\":false}}","posts",["Map",11,12,54,55,80,81,111,112],"cloudflare-deploy",{"id":11,"data":13,"body":22,"filePath":23,"digest":24,"rendered":25,"legacyId":53},{"title":14,"date":15,"category":16,"tags":17,"draft":20,"summary":21,"pinned":20},"将 Astro 博客部署到 Cloudflare Pages",["Date","2026-07-18T00:00:00.000Z"],"部署",[18,19,16],"Astro","Cloudflare",false,"手把手教你用 Cloudflare Pages 部署 Astro 静态博客，零成本上线。","Cloudflare Pages 是部署静态网站的绝佳选择：全球 CDN、无限带宽、免费 SSL。\n\n## 前置条件\n\n1. 一个 GitHub / GitLab 账号\n2. 将博客代码推送到 Git 仓库\n3. 注册 Cloudflare 账号\n\n## 步骤\n\n### 1. 连接仓库\n\n登录 Cloudflare Dashboard，进入 Workers & Pages → Pages → 连接到 Git。\n\n选择你的博客仓库。\n\n### 2. 配置构建设置\n\n| 设置项 | 值 |\n|--------|-----|\n| 框架预设 | Astro |\n| 构建命令 | `npm run build` |\n| 输出目录 | `dist` |\n| Node 版本 | 20.x |\n\n### 3. 部署\n\n点击保存并部署，Cloudflare 会自动构建并部署你的站点。\n\n### 4. 绑定自定义域名\n\n在 Pages 项目的\"自定义域\"中，添加你的域名并按照指引配置 DNS。\n\n---\n\n部署完成后，每次 `git push` 都会自动触发新的构建和部署。整个过程零成本，而且速度很快。","src/content/posts/cloudflare-deploy.md","e886994978490754",{"html":26,"metadata":27},"\u003Cp>Cloudflare Pages 是部署静态网站的绝佳选择：全球 CDN、无限带宽、免费 SSL。\u003C/p>\n\u003Ch2 id=\"前置条件\">前置条件\u003C/h2>\n\u003Col>\n\u003Cli>一个 GitHub / GitLab 账号\u003C/li>\n\u003Cli>将博客代码推送到 Git 仓库\u003C/li>\n\u003Cli>注册 Cloudflare 账号\u003C/li>\n\u003C/ol>\n\u003Ch2 id=\"步骤\">步骤\u003C/h2>\n\u003Ch3 id=\"1-连接仓库\">1. 连接仓库\u003C/h3>\n\u003Cp>登录 Cloudflare Dashboard，进入 Workers &#x26; Pages → Pages → 连接到 Git。\u003C/p>\n\u003Cp>选择你的博客仓库。\u003C/p>\n\u003Ch3 id=\"2-配置构建设置\">2. 配置构建设置\u003C/h3>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\u003Ctable>\u003Cthead>\u003Ctr>\u003Cth>设置项\u003C/th>\u003Cth>值\u003C/th>\u003C/tr>\u003C/thead>\u003Ctbody>\u003Ctr>\u003Ctd>框架预设\u003C/td>\u003Ctd>Astro\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>构建命令\u003C/td>\u003Ctd>\u003Ccode>npm run build\u003C/code>\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>输出目录\u003C/td>\u003Ctd>\u003Ccode>dist\u003C/code>\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Node 版本\u003C/td>\u003Ctd>20.x\u003C/td>\u003C/tr>\u003C/tbody>\u003C/table>\n\u003Ch3 id=\"3-部署\">3. 部署\u003C/h3>\n\u003Cp>点击保存并部署，Cloudflare 会自动构建并部署你的站点。\u003C/p>\n\u003Ch3 id=\"4-绑定自定义域名\">4. 绑定自定义域名\u003C/h3>\n\u003Cp>在 Pages 项目的”自定义域”中，添加你的域名并按照指引配置 DNS。\u003C/p>\n\u003Chr>\n\u003Cp>部署完成后，每次 \u003Ccode>git push\u003C/code> 都会自动触发新的构建和部署。整个过程零成本，而且速度很快。\u003C/p>",{"headings":28,"localImagePaths":47,"remoteImagePaths":48,"frontmatter":49,"imagePaths":52},[29,32,34,38,41,44],{"depth":30,"slug":31,"text":31},2,"前置条件",{"depth":30,"slug":33,"text":33},"步骤",{"depth":35,"slug":36,"text":37},3,"1-连接仓库","1. 连接仓库",{"depth":35,"slug":39,"text":40},"2-配置构建设置","2. 配置构建设置",{"depth":35,"slug":42,"text":43},"3-部署","3. 部署",{"depth":35,"slug":45,"text":46},"4-绑定自定义域名","4. 绑定自定义域名",[],[],{"title":14,"date":50,"category":16,"tags":51,"summary":21},["Date","2026-07-18T00:00:00.000Z"],[18,19,16],[],"cloudflare-deploy.md","hello-world",{"id":54,"data":56,"body":64,"filePath":65,"digest":66,"rendered":67,"legacyId":79},{"title":57,"date":58,"category":59,"tags":60,"draft":20,"summary":62,"pinned":63},"你好，世界",["Date","2026-07-21T00:00:00.000Z"],"杂项",[61,18],"博客","第一篇博客文章，记录这个博客诞生的故事。",true,"## 关于这个博客\n\n这是我新搭建的个人博客。\n\n在这里，我会记录：\n\n- **技术笔记**：踩过的坑、学到的技巧\n- **生活随笔**：日常中的小确幸\n- **读书记录**：好书与思考\n- **摄影**：镜头里的世界\n\n---\n\n建博客这件事想了很久。\n\n从选框架到搭环境，再到写下第一行 Markdown，都是很有趣的旅程。这个博客使用 Astro 构建，部署在 Cloudflare Pages 上——快速、稳定、低成本。\n\n希望这里能成为一方安静的角落，记录那些值得留下的东西。\n\n---\n\n欢迎常来。","src/content/posts/hello-world.md","7cfa2875c0a324c4",{"html":68,"metadata":69},"\u003Ch2 id=\"关于这个博客\">关于这个博客\u003C/h2>\n\u003Cp>这是我新搭建的个人博客。\u003C/p>\n\u003Cp>在这里，我会记录：\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>技术笔记\u003C/strong>：踩过的坑、学到的技巧\u003C/li>\n\u003Cli>\u003Cstrong>生活随笔\u003C/strong>：日常中的小确幸\u003C/li>\n\u003Cli>\u003Cstrong>读书记录\u003C/strong>：好书与思考\u003C/li>\n\u003Cli>\u003Cstrong>摄影\u003C/strong>：镜头里的世界\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Cp>建博客这件事想了很久。\u003C/p>\n\u003Cp>从选框架到搭环境，再到写下第一行 Markdown，都是很有趣的旅程。这个博客使用 Astro 构建，部署在 Cloudflare Pages 上——快速、稳定、低成本。\u003C/p>\n\u003Cp>希望这里能成为一方安静的角落，记录那些值得留下的东西。\u003C/p>\n\u003Chr>\n\u003Cp>欢迎常来。\u003C/p>",{"headings":70,"localImagePaths":73,"remoteImagePaths":74,"frontmatter":75,"imagePaths":78},[71],{"depth":30,"slug":72,"text":72},"关于这个博客",[],[],{"title":57,"date":76,"category":59,"tags":77,"summary":62,"pinned":63},["Date","2026-07-21T00:00:00.000Z"],[61,18],[],"hello-world.md","why-blogging",{"id":80,"data":82,"body":88,"filePath":89,"digest":90,"rendered":91,"legacyId":110},{"title":83,"date":84,"category":59,"tags":85,"draft":20,"summary":87,"pinned":20},"为什么要写博客",["Date","2026-07-19T00:00:00.000Z"],[61,86],"思考","关于坚持写作的几个理由和个人体会。","在信息爆炸的时代，为什么还要写博客？\n\n## 1. 思考的整理\n\n写作是最好的思考方式。当你试图把一件事写清楚时，你会发现自己的理解还不够——这就是深度学习的过程。\n\n> \"If you can't explain it simply, you don't understand it well enough.\"\n> —— Albert Einstein\n\n## 2. 时间的锚点\n\n博客是时间的锚。每隔一段时间回看自己写过的文字，会清晰地感受到成长。\n\n那些曾经让你困惑的问题、让你感动的事情、让你兴奋的技术发现——记录下来，它们就不会在时间中消散。\n\n## 3. 意外连接\n\n你永远不知道哪篇文章会被谁读到，会引发怎样的连接。互联网最迷人的地方就是这种偶然性。\n\n\n写博客不需要追求完美。开始写，比什么都重要。","src/content/posts/why-blogging.md","01a15a379665ef56",{"html":92,"metadata":93},"\u003Cp>在信息爆炸的时代，为什么还要写博客？\u003C/p>\n\u003Ch2 id=\"1-思考的整理\">1. 思考的整理\u003C/h2>\n\u003Cp>写作是最好的思考方式。当你试图把一件事写清楚时，你会发现自己的理解还不够——这就是深度学习的过程。\u003C/p>\n\u003Cblockquote>\n\u003Cp>“If you can’t explain it simply, you don’t understand it well enough.”\n—— Albert Einstein\u003C/p>\n\u003C/blockquote>\n\u003Ch2 id=\"2-时间的锚点\">2. 时间的锚点\u003C/h2>\n\u003Cp>博客是时间的锚。每隔一段时间回看自己写过的文字，会清晰地感受到成长。\u003C/p>\n\u003Cp>那些曾经让你困惑的问题、让你感动的事情、让你兴奋的技术发现——记录下来，它们就不会在时间中消散。\u003C/p>\n\u003Ch2 id=\"3-意外连接\">3. 意外连接\u003C/h2>\n\u003Cp>你永远不知道哪篇文章会被谁读到，会引发怎样的连接。互联网最迷人的地方就是这种偶然性。\u003C/p>\n\u003Cp>写博客不需要追求完美。开始写，比什么都重要。\u003C/p>",{"headings":94,"localImagePaths":104,"remoteImagePaths":105,"frontmatter":106,"imagePaths":109},[95,98,101],{"depth":30,"slug":96,"text":97},"1-思考的整理","1. 思考的整理",{"depth":30,"slug":99,"text":100},"2-时间的锚点","2. 时间的锚点",{"depth":30,"slug":102,"text":103},"3-意外连接","3. 意外连接",[],[],{"title":83,"date":107,"category":59,"tags":108,"summary":87},["Date","2026-07-19T00:00:00.000Z"],[61,86],[],"why-blogging.md","markdown-guide",{"id":111,"data":113,"body":121,"filePath":122,"digest":123,"rendered":124,"legacyId":150},{"title":114,"date":115,"category":116,"tags":117,"draft":20,"summary":120,"pinned":20},"Markdown 写作快速指南",["Date","2026-07-21T00:00:00.000Z"],"技术",[118,119],"Markdown","写作","掌握 Markdown 基础语法，让写作更专注内容本身。","Markdown 是一种轻量级标记语言，让你专注于内容而非排版。\n\n## 基础语法\n\n### 标题\n\n用 `#` 表示标题层级：\n\n```md\n# 一级标题\n## 二级标题\n### 三级标题\n```\n\n### 强调\n\n**加粗**和*斜体*是表达重点的方式。\n\n### 代码\n\n行内代码用反引号：`console.log(\"hello\")`。\n\n代码块用三个反引号并指定语言：\n\n```javascript\nfunction greet(name) {\n  return `Hello, ${name}!`;\n}\n```\n\n### 引用\n\n> 这是一段引用文字。\n> 可以跨越多行。\n\n### 列表\n\n无序列表：\n\n- 第一项\n- 第二项\n  - 嵌套项\n\n有序列表：\n\n1. 第一步\n2. 第二步\n3. 第三步\n\n### 链接和图片\n\n[链接文字](https://example.com)\n\n![图片描述](https://example.com/image.jpg)\n\n## 写在最后\n\nMarkdown 的核心理念是：**简单即是力量**。掌握这些基础语法，你就能写出漂亮的文章。","src/content/posts/markdown-guide.md","835f47f7d8940831",{"html":125,"metadata":126},"\u003Cp>Markdown 是一种轻量级标记语言，让你专注于内容而非排版。\u003C/p>\n\u003Ch2 id=\"基础语法\">基础语法\u003C/h2>\n\u003Ch3 id=\"标题\">标题\u003C/h3>\n\u003Cp>用 \u003Ccode>#\u003C/code> 表示标题层级：\u003C/p>\n\u003Cpre class=\"astro-code github-dark-dimmed\" style=\"background-color:#22272e;color:#adbac7; overflow-x: auto; white-space: pre-wrap; word-wrap: break-word;\" tabindex=\"0\" data-language=\"md\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:#6CB6FF;font-weight:bold\"># 一级标题\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#6CB6FF;font-weight:bold\">## 二级标题\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#6CB6FF;font-weight:bold\">### 三级标题\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\n\u003Ch3 id=\"强调\">强调\u003C/h3>\n\u003Cp>\u003Cstrong>加粗\u003C/strong>和\u003Cem>斜体\u003C/em>是表达重点的方式。\u003C/p>\n\u003Ch3 id=\"代码\">代码\u003C/h3>\n\u003Cp>行内代码用反引号：\u003Ccode>console.log(\"hello\")\u003C/code>。\u003C/p>\n\u003Cp>代码块用三个反引号并指定语言：\u003C/p>\n\u003Cpre class=\"astro-code github-dark-dimmed\" style=\"background-color:#22272e;color:#adbac7; overflow-x: auto; white-space: pre-wrap; word-wrap: break-word;\" tabindex=\"0\" data-language=\"javascript\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:#F47067\">function\u003C/span>\u003Cspan style=\"color:#DCBDFB\"> greet\u003C/span>\u003Cspan style=\"color:#ADBAC7\">(\u003C/span>\u003Cspan style=\"color:#F69D50\">name\u003C/span>\u003Cspan style=\"color:#ADBAC7\">) {\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#F47067\">  return\u003C/span>\u003Cspan style=\"color:#96D0FF\"> `Hello, ${\u003C/span>\u003Cspan style=\"color:#ADBAC7\">name\u003C/span>\u003Cspan style=\"color:#96D0FF\">}!`\u003C/span>\u003Cspan style=\"color:#ADBAC7\">;\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#ADBAC7\">}\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\n\u003Ch3 id=\"引用\">引用\u003C/h3>\n\u003Cblockquote>\n\u003Cp>这是一段引用文字。\n可以跨越多行。\u003C/p>\n\u003C/blockquote>\n\u003Ch3 id=\"列表\">列表\u003C/h3>\n\u003Cp>无序列表：\u003C/p>\n\u003Cul>\n\u003Cli>第一项\u003C/li>\n\u003Cli>第二项\n\u003Cul>\n\u003Cli>嵌套项\u003C/li>\n\u003C/ul>\n\u003C/li>\n\u003C/ul>\n\u003Cp>有序列表：\u003C/p>\n\u003Col>\n\u003Cli>第一步\u003C/li>\n\u003Cli>第二步\u003C/li>\n\u003Cli>第三步\u003C/li>\n\u003C/ol>\n\u003Ch3 id=\"链接和图片\">链接和图片\u003C/h3>\n\u003Cp>\u003Ca href=\"https://example.com\">链接文字\u003C/a>\u003C/p>\n\u003Cp>\u003Cimg src=\"https://example.com/image.jpg\" alt=\"图片描述\">\u003C/p>\n\u003Ch2 id=\"写在最后\">写在最后\u003C/h2>\n\u003Cp>Markdown 的核心理念是：\u003Cstrong>简单即是力量\u003C/strong>。掌握这些基础语法，你就能写出漂亮的文章。\u003C/p>",{"headings":127,"localImagePaths":144,"remoteImagePaths":145,"frontmatter":146,"imagePaths":149},[128,130,132,134,136,138,140,142],{"depth":30,"slug":129,"text":129},"基础语法",{"depth":35,"slug":131,"text":131},"标题",{"depth":35,"slug":133,"text":133},"强调",{"depth":35,"slug":135,"text":135},"代码",{"depth":35,"slug":137,"text":137},"引用",{"depth":35,"slug":139,"text":139},"列表",{"depth":35,"slug":141,"text":141},"链接和图片",{"depth":30,"slug":143,"text":143},"写在最后",[],[],{"title":114,"date":147,"category":116,"tags":148,"summary":120},["Date","2026-07-21T00:00:00.000Z"],[118,119],[],"markdown-guide.md","moments",["Map",153,154],"hello",{"id":153,"data":155,"body":157,"filePath":158,"digest":159,"rendered":160,"legacyId":169},{"date":156},["Date","2026-07-21T00:00:00.000Z"],"博客搭好了！用 Astro 构建，简洁轻量。开始记录吧 📝","src/content/moments/hello.md","db599a176bbe2cd2",{"html":161,"metadata":162},"\u003Cp>博客搭好了！用 Astro 构建，简洁轻量。开始记录吧 📝\u003C/p>",{"headings":163,"localImagePaths":164,"remoteImagePaths":165,"frontmatter":166,"imagePaths":168},[],[],[],{"date":167},["Date","2026-07-21T00:00:00.000Z"],[],"hello.md"]